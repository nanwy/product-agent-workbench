{
  "name": "product-agent-workbench-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.32.1 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @product-agent-workbench/web dev",
    "dev:spa": "pnpm --filter @product-agent-workbench/web dev:spa",
    "build": "pnpm --filter @product-agent-workbench/web build",
    "build:spa": "pnpm --filter @product-agent-workbench/web build:spa",
    "build:standalone": "pnpm build:spa && go build -o apps/server/workbench ./apps/server/cmd/workbench",
    "workbench": "pnpm build:spa && go run ./apps/server/cmd/workbench",
    "start": "pnpm --filter @product-agent-workbench/web start",
    "typecheck": "pnpm --filter @product-agent-workbench/web typecheck",
    "test": "pnpm --filter @product-agent-workbench/web test",
    "test:e2e": "pnpm --filter @product-agent-workbench/web test:e2e",
    "test:server": "go test ./apps/server/...",
    "check": "pnpm typecheck && pnpm test && pnpm build:spa && pnpm test:server && pnpm build"
  }
}
