{
  "name": "Mysterious-Realm-v2 / front",
  "repositoryRoot": "../../Mysterious-Realm-v2",
  "modificationScope": "apps/front",
  "startCommand": {
    "command": "pnpm",
    "args": ["--filter", "front", "dev"]
  },
  "healthUrl": "http://127.0.0.1:3003",
  "previewUrl": "http://127.0.0.1:3003",
  "previewGatewayPort": 3100,
  "startupTimeoutMs": 60000,
  "validationCommands": [
    {
      "id": "front-typecheck",
      "label": "Front TypeScript",
      "command": "pnpm",
      "args": ["-F", "front", "typecheck"],
      "timeoutMs": 120000,
      "environment": "production",
      "proxyPolicy": "auto"
    },
    {
      "id": "front-test",
      "label": "Front focused integration test",
      "command": "pnpm",
      "args": ["-F", "front", "test:event-map-focus"],
      "timeoutMs": 120000,
      "environment": "test",
      "proxyPolicy": "auto",
      "requiresRuntime": true
    },
    {
      "id": "front-build",
      "label": "Front production build",
      "command": "pnpm",
      "args": ["-F", "front", "build"],
      "timeoutMs": 300000,
      "environment": "production",
      "proxyPolicy": "auto"
    }
  ]
}
