{
  "name": "Fixture Product / front",
  "repositoryRoot": "./target-project",
  "modificationScope": "apps/front",
  "startCommand": {
    "command": "node",
    "args": ["server.mjs"]
  },
  "healthUrl": "http://127.0.0.1:4173/health",
  "previewUrl": "http://127.0.0.1:4173",
  "previewGatewayPort": 4174,
  "startupTimeoutMs": 5000,
  "runtimeReuse": {
    "healthBodyIncludes": "Fixture target"
  },
  "validationCommands": [
    {
      "id": "fixture-check",
      "label": "Fixture validation",
      "command": "node",
      "args": ["-e", "process.exit(0)"],
      "timeoutMs": 5000,
      "environment": "test",
      "proxyPolicy": "omit"
    }
  ]
}
